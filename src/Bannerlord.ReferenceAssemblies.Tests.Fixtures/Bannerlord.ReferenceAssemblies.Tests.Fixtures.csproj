<Project Sdk="Microsoft.NET.Sdk">
  <!--
    What the GUI scanner tests read: stand-ins for the few TaleWorlds types the scanner knows by name, and
    the ways the game passes movie names and ViewModels to GauntletLayer.LoadMovie, each in miniature. The
    tests load the compiled file; nothing here runs. Always optimized, so the IL is the same in Debug and
    Release test runs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649;CS8321</NoWarn>
  </PropertyGroup>
</Project>
